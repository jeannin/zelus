(* Tests parallel streams with branching. Tests that the absolute value of some stream is nonnegative. 

This test should PASS

Expected VC is:
* (y >= 0.) => ((ite (x >= 0.) x (-. x)) >= 0.)
*)
let node exec () = 
	let rec x = 1. fby (-. x)
		and (y:{v:float | v >= 0.}) = (if (x > 0.) then x else (-. x))
		in ()
