let node main () =
    let dt = 0.1 in 
    let margin = 2. in 
    let set = 16. in
    let maxpower = 0.5 in 
    let minpower = 0. in
    let heatloss = 0.1 in 
    let t_i = 15. in
    let p_i = maxpower in
    let rec (power, temp) :
        (float * float) {box( ((temp <= (set +. margin)) && (temp >= (set -. margin))) && 
                             ((temp <= set && power = maxpower) || (temp > set && power = minpower)) )} = (p_i, t_i) fby (
        (if (temp <= set)
        then maxpower
        else minpower), temp +. dt *. (power -. heatloss)) in (power, temp)