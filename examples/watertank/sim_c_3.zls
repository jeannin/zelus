(* No main_robot. Just a controller node that we implicitly assume will be compiled into robot code.
   Inputs and outputs are mapped at compile-time to the sensors/actuators on the physical robot.
   Note the absence of explicit getters/setters for robot parts
   For simulation, the following nodes are used:
	* controller
	* sim_tank
	* main_sim
	* graph
   
   For compilation on a physical robot, the following node is used (nothing else runs)
	* controller
*)
let initlevel = 2.
let minlevel = 1.
let maxlevel = 5.
let maxflow = 3.
let outflow = -1.
let margin = 0.5
let dt = 0.1

(* Trying to see if we can make robot code functional (assuming we don't need robot_get and robot_put anymore *)
(* mlevel -> maps to actual level sensor input on the robot *)
(* cflow -> maps to the actual valve control on the robot *)
let node controller(mlevel) = cflow where
	rec cflow = (if mlevel <= minlevel +. margin then maxflow
		else if mlevel >= maxlevel -. margin then 0. else (0. fby cflow))

let hybrid sim_tank(cflow) = mlevel where
	der mlevel = (cflow +. outflow) init initlevel 

let node graph(cflow, mlevel, t) = 
	let s = Scope.scope2
		(0., 5.,
			("mlevel", Scope.linear, mlevel),
			("cflow", Scope.points true, cflow)) in
	Scope.window ("Water tank", 10.0, t, s)

let hybrid main_sim () = 
	let clock = (period (dt))
	and der t = 1. init 0. in
	
	let rec (* C *) level = sim_tank(flow)
	and (* C *) flow = (* AD and DA *) present (clock) -> (* D -> D *) controller(level) init 0.
	in present (clock) -> (print_float level; print_newline (); graph(cflow, level, t)) init ()

