let initlevel:{v:float | v >= 0.} = 2.
let minlevel:{v:float | v >= 0.} = 1.
let maxlevel:{v:float | v > minlevel} = 5.
let maxflow:{v:float | v >= 0.} = 3.
let outflow:{v:float | v <= 0.} = -1.
let margin:{v:float | v >= 0.} = 0.5
let dt:{v:float | v > 0.}= 0.1

(*
m:float -> {c:float |
(m <= (minlevel +. margin) && (cflow +. outflow >= 0.)) || (m >= (maxlevel -. margin) && (cflow +. outflow ‹= 0.))}*)
let node controller(mlevel) = cflow where
	rec cflow = (if mlevel <= minlevel +. margin then maxflow
		else if mlevel >= maxlevel -. margin then 0. else (0. fby cflow))

let node sim_tank(cflow) = mlevel where
	rec mlevel = initlevel fby (mlevel +. ((cflow +. outflow) *. dt))
