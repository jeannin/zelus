
let initlevel = 2.
let minlevel = 1.
let maxlevel = 5.
(* Appears to be an off-by-one error in the continuous or discrete version, as the simulation runs one more cycle before switching when maxflow is exactly 3 *)
let maxflow = 3.
let outflow = -1.
let margin = 0.5
let dt = 0.1


let node controller(mlevel) = cflow where
	rec cflow = (if mlevel <= minlevel +. margin then maxflow
		else if mlevel >= maxlevel -. margin then 0. else (0. fby cflow))

let hybrid sim_tank(cflow) = mlevel where
	der mlevel = (cflow +. outflow) init initlevel 

let node robot_put(key, value) = (print_string "Put value:"); (print_string key); (print_string "->"); (print_float value); (print_newline ())

let node robot_get(key) = mlevel where
	rec mlevel = 5. 
	and () = (print_string "Get value: "); (print_string key); (print_string "<-"); (print_float mlevel); (print_newline ()) 

let node io_tank(cflow) = mlevel where
	mlevel = (robot_get ("level"))
	and () = (robot_put("flow", cflow))

let node graph(cflow, mlevel, t) = 
	let s = Scope.scope2
		(0., 5.,
			("mlevel", Scope.linear, mlevel),
			("cflow", Scope.points true, cflow)) in
	Scope.window ("Water tank", 10.0, t, s)

let sample(level) = level	



(* A modified controller that instead relies on zero crossings to regulate the water level *)
let hybrid main_sim () = 
	let clock = (period (dt)) 
	and der t = 1. init 0. in

	(* init 0. is not used because clock is present at the first instant *)
	let rec level = sim_tank(cflow)
	and trip_high = up(level -. maxlevel)
    and trip_low = up(-. (level -. minlevel))
	(* Setting up multiple zero crossing listeners *)
    and cflow = present
		| trip_high -> 0.
		| trip_low -> maxflow 
	init maxflow
     
	in present (clock) -> (print_float level; print_newline (); graph(cflow, level, t)) init ()

(* The original hybrid model with a polling controller *)
(*
let hybrid main_sim () = 
	let clock = (period (dt)) 
	and der t = 1. init 0. in

	(* init 0. is not used because clock is present at the first instant *)
	let rec cflow = present (clock) -> let mlevel = sample(level) in controller(mlevel) init 0.
	and level = sim_tank(cflow) 
	in present (clock) -> (print_float level; print_newline (); graph(cflow, level, t)) init ()*)


(* The thing that compiles to the physical robot controller *)
let node main_robot2 (mlevel, cflow) = (mlevel, cflow) where 
	rec cflow = controller(mlevel)
    and mlevel = io_tank(cflow)

(*
(* Trying to tease apart the physical robot, runs fine *)
let node main_robot () = () where
	rec t = 0. fby t +. dt
    and (mlevel, cflow) = main_robot2(mlevel, cflow) 
    and () = graph(cflow, mlevel, t)*)

(* Can we make the main robot continuous? *)
let hybrid main_robot () =
 	let clock = (period (dt)) 
	and der t = 1. init 0. in
	
	
    (present(clock) -> let rec (mlevel, cflow) = main_robot2(mlevel, cflow) 
		in graph(cflow, mlevel, t)
	init ())



