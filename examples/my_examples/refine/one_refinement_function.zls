let add101 (x : {v:int | v>0}) (y : int) : int = x + y 
let add102 (x : int) (y : {v:int | v>0}) : int = x + y 

(* - only return type is refinement *)
(* True case: *)
let f101 (x : int) (y : int) : {v:int | v >= 0} = x*x + y*y
(* False case: *)
let f102 (x : int) (y : int) : {v:int | v > 0} = x + y 

(* - both input and output type is refinement *)
let add103 (x : {v:int | v > 0}) (y : {v:int | v > 0}) : {v:int | (v > 0) && (v = x+y)} = x + y 

(* - no refinement *)
let add104 (x:int) (y:int) : int = x+y
let add105 (x:int) (y:int) = x+y
let add106 (x:int) y = x+y
let add107 x y = x+y   
