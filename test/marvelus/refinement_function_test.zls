(* Unit tests for refinement functions *)

(*
	TEST 1: refinement function declaration

	- multiple refinement inputs
	- two function body expressions
*)
let f1 (a : {v:int|v > 0}) (b : {v:int|v >= 0}) (c : {v:int|v > 0}) : {v:int|v > 0}  =  
	   let y = a + b in
	   y


(*
	TEST 2: refinement functions as a math proof

	- prove that the square of any negative number is a positive number
*)
let f2 (x : {v:int| v <= 0 }) : {v:int| v >= 0 } =
         let y = x * x in
		 y

(*
	TEST 3:

	- same as above but as a direct expression
*)
let f3 (x : {v:int|v>0}) : {v:int|v>0} = x*x

(*
	TEST 4: refinement function with multiple constraints in return type

	- constraint on function inputs
	- logical operator on return type to concatenate constraints
*)
let add (x : {v:float|v>0} ) (y : {v:float|v>0} ) : { v:float | v >= x && v >= y} =
		let z = x +. y 
		in z 

(*
	TEST 5: refinement function with multiple body lines

	- multiple body lines
*)
let f5 (a : {x:int|x>0}) (b : {x:int|x>0}) (c : {x:int|x>0}) : {x : int | x >= 0}  =  
	   let z = a + b in
	   let w = b + c in
	   let y = w + z in
	   y