(* Unit tests for LTL keyword on refinement type definition *)
(*
	- currently supported operator: box, diamond
	- LTL operator can be connected by &&, ||
*)


(*
  TEST 1: usage of LTL operator in refinement variable declaration
*)
let x : {v:int | box(v>=3) || box(v<2)} = 4

(*
  TEST 2: usage of LTL operator in refinement function declaration
*)
let f1 (x : {v:int|v>0}) (y : {v:int|v>0}) : {v:int | box(v >= x) && diamond(v >= y)} =
  x + y 
